+.grade-dim-name em { font-style: normal; font-size: 11px; color: var(--subtle); margin-left: 3px; }
+.grade-levels { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; padding: 3px; background: var(--surface-2); border-radius: 9px; }
+.grade-levels button { height: 30px; border: 0; border-radius: 7px; font-size: 13px; font-weight: 500; color: var(--muted); background: transparent; }
+.grade-levels button:hover { color: var(--text); }
+.grade-levels button.on { background: var(--paper); color: var(--text); font-weight: 600; box-shadow: 0 1px 2px #00000012, 0 0 0 1px var(--border); }
+.grade-fine { margin-top: 4px; border: 1px solid var(--border); border-radius: 9px; padding: 10px 12px; }
+.grade-fine > summary { font-size: 13px; color: var(--muted); cursor: pointer; }
