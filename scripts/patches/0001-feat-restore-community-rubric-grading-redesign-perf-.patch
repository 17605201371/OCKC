+function unload(e: BeforeUnloadEvent) {
+  if (dirty.value) {
+    sessionBackup();
+    e.preventDefault();
+    e.returnValue = '';
+  }
+}
+
+onMounted(() => {
+  window.addEventListener('beforeunload', unload);
+  void load();
+});
+onBeforeUnmount(() => {
+  alive = false;
+  window.removeEventListener('beforeunload', unload);
+});
