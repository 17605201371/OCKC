+.grade-fine-group h5 { font-size: 12px; font-weight: 600; color: var(--subtle); margin-bottom: 4px; }
+.grade-fine-row { display: grid; grid-template-columns: 68px 88px; gap: 6px; align-items: center; padding: 7px 0; border-top: 1px dashed var(--line-soft); }
+.grade-fine-row:first-child { border-top: 0; }
+.grade-fine-row > label { grid-column: 1 / -1; display: flex; align-items: center; gap: 6px; min-width: 0; font-size: 12px; color: var(--text); }
+.grade-fine-row > label code { flex: none; font-size: 11px; color: var(--blue-text); background: var(--blue-soft); border-radius: 3px; padding: 0 4px; }
+.grade-fine-row > input, .grade-fine-row > select { font-size: 12px; padding: 5px 7px; min-height: 30px; }
+.grade-fine-row > input[placeholder="不适用理由"] { grid-column: 1 / -1; }
+.grade-anchor { grid-column: 1 / -1; }
+.grade-anchor > summary { font-size: 11px; color: var(--subtle); cursor: pointer; }
+.grade-anchor p { font-size: 12px; color: var(--muted); line-height: 1.6; margin: 4px 0; }
+.grade-quick { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
+.grade-chip { height: 26px; padding: 0 9px; border: 1px solid var(--border); border-radius: 13px; background: var(--paper); font-size: 12px; color: var(--muted); }
+.grade-chip:hover { border-color: var(--subtle); color: var(--text); }
+.grade-gate { margin-top: 12px; border: 1px solid var(--border); border-radius: 9px; padding: 10px 12px; }
+.grade-gate > summary { font-size: 12px; color: var(--muted); cursor: pointer; }
+.grade-gate textarea { margin-top: 8px; font-size: 13px; }
+.grade-tip { display: flex; align-items: flex-start; gap: 6px; margin-top: 12px; font-size: 12px; color: var(--subtle); line-height: 1.6; }
+.grade-feedback { padding: 12px 18px 16px; border-top: 1px solid var(--line-soft); }
+.grade-feedback > summary { font-size: 13px; color: var(--muted); cursor: pointer; }
+.grade-feedback .feedback-card { margin-top: 12px; }
diff --git a/frontend/src/uid.ts b/frontend/src/uid.ts
new file mode 100644
index 0000000..e9b148d
--- /dev/null
+++ b/frontend/src/uid.ts
@@ -0,0 +1,15 @@
+// crypto.randomUUID 只在安全上下文（https / localhost）可用；
+// 站点用 http://IP:8080 访问时它是 undefined，会让新段落拿不到 blockId、公式插入直接抛错。
+export function uid(): string {
+  const c: any = typeof globalThis !== "undefined" ? (globalThis as any).crypto : undefined;
+  if (c && typeof c.randomUUID === "function") {
+    try { return c.randomUUID(); } catch { /* 回退到下面的实现 */ }
+  }
+  const b = new Uint8Array(16);
+  if (c && typeof c.getRandomValues === "function") c.getRandomValues(b);
+  else for (let i = 0; i < 16; i++) b[i] = Math.floor(Math.random() * 256);
+  b[6] = (b[6] & 0x0f) | 0x40; // version 4
+  b[8] = (b[8] & 0x3f) | 0x80; // variant 10
+  const h = Array.from(b, (x) => x.toString(16).padStart(2, "0")).join("");
+  return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;
+}
