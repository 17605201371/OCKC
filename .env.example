# Copy to .env and set locally generated secrets. Never commit .env.
DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=
# For isolated local evaluation only; disable and remove demonstration accounts before real use.
DEMO_SEED=true
DEMO_PASSWORD=
# false is for localhost HTTP only. Set true behind HTTPS.
COOKIE_SECURE=false
# Optional AI revision suggestions (OpenAI-compatible /chat/completions).
# Leave AI_API_KEY empty to keep AI off; when set, draft text is sent to AI_API_BASE on request.
AI_API_KEY=
AI_API_BASE=https://api.stepfun.com/step_plan/v1
AI_MODEL=step-3.7-flash
